# Supabase: Project Settings > API. Jangan gunakan service_role key di backend ini.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Tambahkan satu atau lebih provider; urutan fallback: Gemini, Groq, OpenRouter.
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys (free/dev availability subject to current limits)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Wajib hanya untuk origin deployment selain dua origin localhost bawaan.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
PORT=8080
